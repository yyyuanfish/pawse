# Unified Pawse app; permanent keys are server-side only.
GEMINI_API_KEY=
# Verified against the developer's assigned project; availability varies.
GEMINI_MODEL=gemini-3-flash-preview

# Clinics, nearby taxis and insurer offices: Google Places first, then Gemini Maps grounding (uses
# GEMINI_API_KEY), then Mapify for clinics. Places needs Places API (New) enabled with billing; Gemini access
# does not imply Places access. Cloud Run reads it from the optional secret pawse-places-key.
GOOGLE_PLACES_API_KEY=
# Interactive map (your live position plus vet/taxi pins): a SEPARATE browser key with only the Maps JavaScript
# API enabled and HTTP-referrer restrictions (your Cloud Run URL, http://127.0.0.1:8765/*). It is sent to the
# browser at runtime; never reuse a server key here. Without it the app shows a keyless embed.
GOOGLE_MAPS_BROWSER_KEY=
# Your map ID from Google Cloud > Map Management (DEMO_MAP_ID is used when empty; fine for testing only).
GOOGLE_MAPS_MAP_ID=
# Model for Grounding with Google Maps; results are shown live only, never stored or exported.
GEMINI_MAPS_MODEL=gemini-3.5-flash-lite
# Optional offline OpenStreetMap snapshot from scripts/crawl_zurich_vets.py (git-ignored, ODbL).
# Default: tmp/crawling/zurich-vets-initial.json when it exists.
PAWSE_CLINIC_SNAPSHOT=
# Mapify service root, with no trailing /api. Do not use its Vercel frontend URL.
MAPIFY_BASE_URL=
MAPIFY_API_TOKEN=

# Optional existing CatAgent bridge. Single-user local development only.
LEGACY_AGENT_BASE_URL=http://127.0.0.1:8000
LEGACY_AGENT_USER_ID=
LEGACY_AGENT_CAT_IDS=

# Voice concierge. Keys stay on the server. Restart after editing .env.
GRADIUM_API_KEY=
# Optional: a German clone/localized voice you own and have approved.
GRADIUM_VOICE_ID_DE=
# Standard German fallback, used only when explicitly selected in the app.
GRADIUM_STANDARD_VOICE_ID_DE=p6Uutkyi3j2iNAUu

# Optional per-role overrides; blank values use GEMINI_MODEL.
# gemini-3.1-pro-preview is also accessible on the tested project.
GEMINI_CARE_MODEL=
GEMINI_VOICE_MODEL=

# Gemini Live voice session (docs/GEMINI_LIVE.md). The server mints single-use tokens; the key never reaches the browser. gemini-3.8-live-extended-thinking for heavier reasoning; see .claude/skills/gemini.
GEMINI_LIVE_MODEL=gemini-3.8-live

# Optional public demo (off locally). These are process-local request caps, not billing limits.
PAWSE_PUBLIC_DEMO=0
PAWSE_ALLOWED_HOSTS=
PAWSE_SESSION_CALLS_PER_HOUR=60
PAWSE_TOTAL_CALLS_PER_HOUR=600
