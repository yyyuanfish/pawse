{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "site",
      "outputDirectory": ".",
      "rewrites": [
        {
          "source": "/landing",
          "destination": "/index.html"
        }
      ],
      "devCommand": "node ../scripts/preview_site.mjs --landing"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build && node ../scripts/package_web_service.mjs",
      "outputDirectory": "deploy",
      "rewrites": [
        {
          "source": "/app",
          "destination": "/app/index.html"
        },
        {
          "source": "/app/",
          "destination": "/app/index.html"
        }
      ],
      "devCommand": "node ../scripts/preview_site.mjs"
    },
    "gateway": {
      "root": "gateway",
      "runtime": "node",
      "entrypoint": "index.mjs",
      "devCommand": "node ../scripts/preview_site.mjs",
      "functions": {
        "index.mjs": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "gateway"
      }
    },
    {
      "source": "/app(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
